# Copy to backend/.env for running the API outside Docker. This file is tracked;
# .env is git-ignored. Every secret below is deliberately EMPTY - fill it in.
# This is a DEMO / PAPER-TRADING platform. No real funds are ever involved.

# ---- Core ----
APP_NAME="CryptoDemo Exchange"
# Simulation guard rail. Never set this to false.
DEMO_MODE=true
DEMO_LABEL="DEMO / PAPER TRADING"
# development | production
ENVIRONMENT=development

# ---- Database ----
DATABASE_URL=postgresql+psycopg://cryptodemo:cryptodemo@localhost:5432/cryptodemo
# For local test runs without Postgres:
# DATABASE_URL=sqlite+pysqlite:///./cryptodemo.db

# ---- Security ----
# REQUIRED SECRET - no default. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
# true whenever the app is served over HTTPS
COOKIE_SECURE=false
# Leave blank unless the API and UI share one parent domain
COOKIE_DOMAIN=
# lax | strict | none  ("none" requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
# How long a single-use password-reset token stays valid
PASSWORD_RESET_TTL_MINUTES=60

# ---- Seed accounts (python -m app.db.seed) ----
SEED_ADMIN_EMAIL=admin@example.com
# SECRET - leave EMPTY to have the seed generate a strong password and print it
# once. It is stored only as an Argon2id hash and cannot be recovered.
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=

# ---- Market data (public prices; positions taken against them are simulated) ----
MARKET_DATA_PROVIDER=binance
# api.binance.com is blocked from many datacenter IPs.
# Fallbacks with the identical API: https://api1.binance.com
MARKET_DATA_BASE_URL=https://data-api.binance.vision
# SECRET - only needed by providers that require a key
MARKET_DATA_API_KEY=
MARKET_DATA_CACHE_SECONDS=10

# ---- Simulated KYC (demo only - never upload real identity documents) ----
KYC_UPLOAD_DIR=/app/uploads/kyc

# ---- Support ----
SUPPORT_EMAIL=support@cryptodemo.example

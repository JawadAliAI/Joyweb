# Copy to .env and fill in every blank. .env is git-ignored; this file is not.
#
#   cp .env.example .env
#
# Secrets are deliberately EMPTY here. docker-compose.yml uses ${VAR:?...} for
# them, so compose refuses to start rather than falling back to a guessable
# default. Generate strong values, e.g.:
#
#   openssl rand -hex 32
#
# This is a DEMO / PAPER-TRADING platform. No real funds are ever involved.

# ---- Database (service: db) ----
POSTGRES_DB=cryptodemo
POSTGRES_USER=cryptodemo
# REQUIRED - no default. Compose fails loudly if this is empty.
POSTGRES_PASSWORD=

# ---- Backend ----
APP_NAME=CryptoDemo Exchange
DEMO_LABEL=DEMO / PAPER TRADING
# production | development
ENVIRONMENT=production
# REQUIRED - no default. Long random string, e.g. openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
# true when served over HTTPS; false for plain-HTTP local development
COOKIE_SECURE=true
# Leave blank unless you serve the API and UI from one parent domain
COOKIE_DOMAIN=
# lax | strict | none  ("none" requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# How long a single-use password-reset token stays valid
PASSWORD_RESET_TTL_MINUTES=60
SUPPORT_EMAIL=support@cryptodemo.example
BACKEND_PORT=8000

# ---- Seed accounts (make seed) ----
SEED_ADMIN_EMAIL=admin@example.com
# Leave EMPTY to have the seed generate a strong password and print it once.
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=

# ---- Market data (public prices; positions taken against them are simulated) ----
MARKET_DATA_PROVIDER=binance
# api.binance.com is blocked from many datacenter IPs.
# Fallbacks with the identical API: https://api1.binance.com
MARKET_DATA_BASE_URL=https://data-api.binance.vision
# Optional - only needed by providers that require a key
MARKET_DATA_API_KEY=
MARKET_DATA_CACHE_SECONDS=10

# ---- Frontend ----
# Path/URL the BROWSER uses to reach the API (baked in at build time). Keep it
# relative so everything is same-origin and the HTTP-only auth cookies work
# without any cross-site cookie configuration; next.config.mjs rewrites /api/*.
NEXT_PUBLIC_API_URL=/api
# Where the Next.js SERVER proxies /api/* to. Inside compose this is the backend
# service name, never localhost. Set it to the public backend URL on Vercel.
BACKEND_INTERNAL_URL=http://backend:8000
# Brand fallbacks rendered before /api/platform/config responds
NEXT_PUBLIC_APP_NAME=CryptoDemo Exchange
NEXT_PUBLIC_DEMO_LABEL=DEMO / PAPER TRADING
FRONTEND_PORT=3000

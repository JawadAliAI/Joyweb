# URL the browser uses. Leave as a relative path to use the built-in proxy.
NEXT_PUBLIC_API_URL=/api

# URL the Next.js server uses to reach the backend (server-side + rewrites).
BACKEND_INTERNAL_URL=http://localhost:8000

# Brand fallbacks used before /api/platform/config responds.
NEXT_PUBLIC_APP_NAME=CryptoDemo Exchange
NEXT_PUBLIC_DEMO_LABEL=DEMO / PAPER TRADING
